+++ b/internal/compiler/widgets/cupertino/tableview.slint
@@ -237,9 +237,11 @@ export component StandardTableView {
         }
 
         scroll-view := ListView {
+            accessible-item-count: root.rows.length;
             for row[idx] in root.rows : TableViewRow {
                 accessible-label: row[0].text; // ponytail: first cell names the row
                 accessible-item-index: idx;
+                accessible-item-count: root.rows.length;
                 selected: idx == root.current-row;
                 even: mod(idx, 2) == 0;
 

+    /// Replaces the selected text, by invoking the element's `accessible-action-replace-selected-text`
+    /// callback. Note that you can only do this if that callback is declared in your Slint code.
+    pub fn replace_accessible_selected_text(&self, text: impl Into<SharedString>) {
+        if self.element_index != 0 {
+            return;
+        }
+        if let Some(item) = self.item.upgrade() {
+            item.accessible_action(&AccessibilityAction::ReplaceSelectedText(text.into()))
+        }
+    }
+
+    /// The accessibility actions the element supports, as AccessKit would be told.
+    /// `Click`, `Focus` and so on are reported by name.
+    pub fn accessible_actions(&self) -> Vec<&'static str> {
+        use i_slint_core::accessibility::{
+            SupportedAccessibilityAction as S, accessible_has_context_menu,
+            accessible_scroll_target,
+        };
+        if self.element_index != 0 {
+            return Default::default();
+        }
+        let Some(item) = self.item.upgrade() else { return Default::default() };
+        let supported = item.supported_accessibility_actions();
+        let mut actions = Vec::new();
+        for (flag, name) in [
+            (S::Default, "Click"),
+            (S::Decrement, "Decrement"),
+            (S::Increment, "Increment"),
+            (S::SetValue, "SetValue"),
+            (S::ReplaceSelectedText, "ReplaceSelectedText"),
+            (S::Expand, "Expand"),
+            (S::SetSelectionOffsets, "SetTextSelection"),
+        ] {
+            if supported.contains(flag) {
+                actions.push(name);
+            }
+        }
+        if accessible_scroll_target(&item) {
+            actions.push("ScrollIntoView");
+        }
+        if accessible_has_context_menu(&item) {
+            actions.push("ShowContextMenu");
+        }
+        actions
+    }
+
+    /// Opens the context menu around the element, as the `ShowContextMenu` action does.
+    /// Returns whether there is one.
+    pub fn invoke_accessible_show_context_menu(&self) -> bool {
+        self.element_index == 0
+            && self.item.upgrade().is_some_and(|item| {
+                i_slint_core::accessibility::accessible_show_context_menu(&item)
+            })
+    }
+
+    /// Scrolls the element into view, as the `ScrollIntoView` action does.
+    pub fn invoke_accessible_scroll_into_view(&self) {
+        if self.element_index != 0 {
+            return;
+        }
+        if let Some(item) = self.item.upgrade() {
+            item.try_scroll_into_visible()
+        }
+    }
+
     /// Returns the value of the element's `accessible-value-maximum` property, if present.
     pub fn accessible_value_maximum(&self) -> Option<f32> {
         if self.element_index != 0 {

@@ -1023,6 +1044,8 @@ fn from(value: accesskit_winit::Event) -> Self {
 pub enum DeferredAccessKitAction {
     SetFocus(ItemRc),
     InvokeAccessibleAction(ItemRc, AccessibilityAction),
+    ScrollIntoView(ItemRc),
+    ShowContextMenu(ItemRc),
 }
 
 impl DeferredAccessKitAction {
@@ -1035,6 +1058,10 @@ pub fn invoke(&self, window: &Window) {
             DeferredAccessKitAction::InvokeAccessibleAction(item, accessibility_action) => {
                 item.accessible_action(accessibility_action);
             }
+            DeferredAccessKitAction::ScrollIntoView(item) => item.try_scroll_into_visible(),
+            DeferredAccessKitAction::ShowContextMenu(item) => {
+                accessible_show_context_menu(item);
+            }

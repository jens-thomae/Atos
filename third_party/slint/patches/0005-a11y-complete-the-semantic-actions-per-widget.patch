+/// The nearest enabled context menu around `item`, `item` included.
+fn enclosing_context_menu(item: &ItemRc) -> Option<ItemRc> {
+    let mut current = Some(item.clone());
+    while let Some(i) = current {
+        if i.downcast::<ContextMenu>().is_some_and(|m| m.as_pin_ref().enabled()) {
+            return Some(i);
+        }
+        current = i.parent_item(ParentItemTraversalMode::StopAtPopups);
+    }
+    None
+}
+
+/// Whether `item` is inside an enabled `ContextMenuArea`, so `ShowContextMenu` applies to it.
+pub fn accessible_has_context_menu(item: &ItemRc) -> bool {
+    enclosing_context_menu(item).is_some()
+}
+
+/// Opens the context menu around `item` at the center of `item`. Returns whether there is one.
+pub fn accessible_show_context_menu(item: &ItemRc) -> bool {
+    let Some(menu) = enclosing_context_menu(item) else { return false };
+    let size = item.geometry().size;
+    let center =
+        item.map_to_window(crate::lengths::LogicalPoint::new(size.width / 2.0, size.height / 2.0));
+    let origin = menu.map_to_window(Default::default());
+    let position = crate::api::LogicalPosition::new(center.x - origin.x, center.y - origin.y);
+    if let Some(context_menu) = menu.downcast::<ContextMenu>() {
+        context_menu.as_pin_ref().show.call(&(position,));
+    }
+    true
+}
+
+/// Whether `item` is inside a `Flickable` (not crossing popups), so `ScrollIntoView` applies to it.
+pub fn accessible_scroll_target(item: &ItemRc) -> bool {
+    let mut current = item.parent_item(ParentItemTraversalMode::StopAtPopups);
+    while let Some(i) = current {
+        if i.downcast::<Flickable>().is_some() {
+            return true;
+        }
+        current = i.parent_item(ParentItemTraversalMode::StopAtPopups);
+    }
+    false
+}

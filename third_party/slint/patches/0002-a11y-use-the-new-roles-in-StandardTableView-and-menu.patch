 component TableViewRow inherits Rectangle {
+    accessible-role: row;
+    accessible-item-selectable: true;
+    accessible-item-selected: root.selected;
+    accessible-action-default => { root.clicked(); }
     in property <bool> selected;
     in property <bool> even;
 
@@ -226,6 +231,7 @@ export component StandardTableView {
                 min-height: root.min-header-height;
 
                 for column[index] in root.columns : TableViewColumn {
+                    accessible-label: column.title;
                     sort-order: column.sort-order;
                     horizontal-stretch: column.horizontal-stretch;
                     min-width: max(column.min-width, column.width);
@@ -252,6 +258,8 @@ export component StandardTableView {
 
         scroll-view := ListView {
             for row[idx] in root.rows : TableViewRow {
+                accessible-label: row[0].text; // ponytail: first cell names the row
+                accessible-item-index: idx;
                 selected: idx == root.current-row;
                 even: mod(idx, 2) == 0;
 
diff --git a/internal/compiler/widgets/material/tableview.slint b/internal/compiler/widgets/material/tableview.slint
index 98933bb..9c047ec 100644
--- a/internal/compiler/widgets/material/tableview.slint
+++ b/internal/compiler/widgets/material/tableview.slint
@@ -6,6 +6,7 @@ import { StateLayer } from "components.slint";
 import { MaterialPalette, Icons } from "styling.slint";
 
 component TableViewColumn inherits Rectangle {
+    accessible-role: column-header;
     in property <SortOrder> sort-order: SortOrder.unsorted;
 
     callback clicked <=> state-layer.clicked;
@@ -90,6 +91,10 @@ component TableViewCell inherits Rectangle {
 }
 
 component TableViewRow inherits Rectangle {
+    accessible-role: row;
+    accessible-item-selectable: true;
+    accessible-item-selected: root.selected;
+    accessible-action-default => { root.clicked(); }
     in property <bool> selected;
     out property <length> mouse-x <=> state-layer.mouse-x;
     out property <length> mouse-y <=> state-layer.mouse-y;
@@ -193,6 +198,7 @@ export component StandardTableView {
                 vertical-stretch: 0;
 
                 for column[index] in root.columns : TableViewColumn {
+                    accessible-label: column.title;
                     sort-order: column.sort-order;
                     horizontal-stretch: column.horizontal-stretch;
                     min-width: max(column.min-width, column.width);
@@ -219,6 +225,8 @@ export component StandardTableView {
 
         scroll-view := ListView {
             for row[idx] in root.rows : TableViewRow {
+                accessible-label: row[0].text; // ponytail: first cell names the row
+                accessible-item-index: idx;
                 selected: idx == root.current-row;
 
                 clicked => {

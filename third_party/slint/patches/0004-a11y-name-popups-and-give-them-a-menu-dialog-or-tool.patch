@@ -670,6 +688,7 @@ fn build_new_tree(
 
     fn build_node_without_children(
         &self,
+        id: NodeId,
         item: &ItemRc,
         scale_factor: ScaleFactor,
         window_position: LogicalPoint,
@@ -679,7 +698,18 @@ fn build_node_without_children(
             .is_some_and(|x| x == "true");
 
         let (role, label) = if let Some(window_item) = item.downcast::<WindowItem>() {
-            (Role::Window, Some(window_item.as_pin_ref().title().to_string()))
+            // A popup or a `Dialog` is a named Menu, Dialog or Tooltip; other windows stay Window.
+            let role = window_role(
+                self.popup_roles.get(&id).copied(),
+                item.accessible_role() == i_slint_core::items::AccessibleRole::Dialog,
+            );
+            let label = window_label(
+                item.accessible_string_property(AccessibleStringProperty::Label)
+                    .as_ref()
+                    .map(|x| x.as_str()),
+                window_item.as_pin_ref().title().as_str(),
+            );
+            (role, Some(label))
         } else {
             (
                 match item.accessible_role() {
@@ -1009,8 +1039,54 @@ pub fn invoke(&self, window: &Window) {
     }
 }
 
+fn popup_role(kind: &WindowKind) -> Role {
+    match kind {
+        WindowKind::Menu => Role::Menu,
+        WindowKind::Popup => Role::Dialog,
+        WindowKind::ToolTip => Role::Tooltip,
+    }
+}
+
+/// A popup root takes its kind's role, a `Dialog` window the dialog role, any other window `Window`.
+fn window_role(popup_role: Option<Role>, is_dialog: bool) -> Role {
+    popup_role.unwrap_or(if is_dialog { Role::Dialog } else { Role::Window })
+}
+
+/// The `accessible-label` of a window item, else its title.
+fn window_label(accessible_label: Option<&str>, title: &str) -> String {
+    accessible_label.filter(|x| !x.is_empty()).unwrap_or(title).to_string()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn popup_kinds_map_to_roles() {
+        assert_eq!(popup_role(&WindowKind::Menu), Role::Menu);
+        assert_eq!(popup_role(&WindowKind::Popup), Role::Dialog);
+        assert_eq!(popup_role(&WindowKind::ToolTip), Role::Tooltip);
+    }
+
+    #[test]
+    fn window_roles() {
+        assert_eq!(window_role(Some(Role::Menu), true), Role::Menu);
+        assert_eq!(window_role(None, true), Role::Dialog);
+        assert_eq!(window_role(None, false), Role::Window);
+    }
+
+    #[test]
+    fn window_names() {
+        assert_eq!(window_label(Some("Network"), "title"), "Network");
+        assert_eq!(window_label(Some(""), "title"), "title");
+        assert_eq!(window_label(None, "title"), "title");
+        assert_eq!(window_label(None, ""), "");
+    }
+}
+
 struct AccessiblePopup {
     location: LogicalPoint,
     parent_node: NodeId,
     component: ItemTreeRc,
+    role: Role,
 }

+++ b/internal/compiler/widgets/cupertino/tableview.slint
@@ -209,6 +209,7 @@ export component StandardTableView {
 
                 for column[index] in root.columns : TableViewColumn {
                     accessible-label: column.title;
+                    accessible-id: root.accessible-id == "" ? "" : root.accessible-id + "/column-" + index;
                     last: index == root.columns.length - 1;
                     sort-order: column.sort-order;
                     horizontal-stretch: column.horizontal-stretch;
@@ -241,6 +242,7 @@ export component StandardTableView {
             for row[idx] in root.rows : TableViewRow {

# Atos base image (C1): a sealed composefs image with a signed UKI and systemd-boot (D-008).
# Docs: docs/components/c1-base/README.md. Recipe: bootc-sealed-images(7).
# Build: podman build --build-context repo=. -f components/c1-base/Containerfile components/c1-base
# (`repo` is the repository root: the compositor source and the toolchain pin come from there.)
# Base: fedora-bootc 45.20261108.0 (D-008), multi-arch index digest, built from our mirror so the pin cannot
# disappear (#117, docs/components/c1-base/base-mirror.md). The upstream line is the audit record and the copy source.
# upstream: quay.io/fedora/fedora-bootc:45@sha256:0c0d822e8545efe843e72f4a216295e9fd3d8a8213709fff0db6844b5d9aad29
ARG BASE=ghcr.io/jens-thomae/atos/fedora-bootc:45.20261108.0@sha256:0c0d822e8545efe843e72f4a216295e9fd3d8a8213709fff0db6844b5d9aad29

# atos-comp (C2) is built in its own stage and only the stripped binary is copied into `base`.
# Same base image, so its layers are already pulled.
FROM ${BASE} AS comp
RUN dnf -y install --setopt=install_weak_deps=False gcc clang pkgconf-pkg-config git curl \
      systemd-devel mesa-libgbm-devel mesa-libEGL-devel libxkbcommon-devel wayland-devel \
      libinput-devel dbus-devel libseat-devel libdisplay-info-devel pixman-devel fontconfig-devel
ARG RUSTUP_VERSION=1.29.3
# /root is a symlink into /var in bootc images, so keep the toolchain elsewhere.
ENV CARGO_HOME=/opt/cargo RUSTUP_HOME=/opt/rustup PATH=/opt/cargo/bin:$PATH
# rustup-init pinned by version; the checksum comes from the same host (integrity, not authenticity).
RUN set -eux; \
    case "$(uname -m)" in x86_64) t=x86_64-unknown-linux-gnu ;; aarch64) t=aarch64-unknown-linux-gnu ;; esac; \
    curl -fsSL -o /tmp/rustup-init "https://static.rust-lang.org/rustup/archive/$RUSTUP_VERSION/$t/rustup-init"; \
    curl -fsSL "https://static.rust-lang.org/rustup/archive/$RUSTUP_VERSION/$t/rustup-init.sha256" | sed 's# .*#  /tmp/rustup-init#' | sha256sum --check; \
    chmod +x /tmp/rustup-init; /tmp/rustup-init -y --no-modify-path --profile minimal --default-toolchain none; rm /tmp/rustup-init
COPY --from=repo rust-toolchain.toml /src/rust-toolchain.toml
COPY --from=repo components/c2-compositor /src/components/c2-compositor
WORKDIR /src/components/c2-compositor
# ponytail: thin LTO (upstream uses fat) to keep the hosted build short; revisit with the budgets.
# Toolchain and target/ are removed in the same step: they do not fit the runner disk as a layer.
RUN cp ../../rust-toolchain.toml . \
    && CARGO_PROFILE_RELEASE_LTO=thin CARGO_TERM_COLOR=never cargo build --release --locked \
    && strip -o /atos-comp target/release/atos-comp \
    && rm -rf target /opt/cargo /opt/rustup

# atos-shell (C3, #186): same recipe as `comp`, plus our pinned Slint (tools/slint-fork/slint-fork.sh setup
# fetches it and applies the patch queue; third_party/slint/patch.toml points cargo at it). The shell is
# outside the root workspace and has its own Cargo.lock; no --locked, as in c3-shell.yml, because the fork's
# path sources replace the crates.io entries. Only the stripped binary is copied into `base`.
FROM ${BASE} AS shell
RUN dnf -y install --setopt=install_weak_deps=False gcc clang clang-devel pkgconf-pkg-config git curl python3 \
      mesa-libEGL-devel libxkbcommon-devel wayland-devel fontconfig-devel pipewire-devel
ARG RUSTUP_VERSION=1.29.3
ENV CARGO_HOME=/opt/cargo RUSTUP_HOME=/opt/rustup PATH=/opt/cargo/bin:$PATH
RUN set -eux; \
    case "$(uname -m)" in x86_64) t=x86_64-unknown-linux-gnu ;; aarch64) t=aarch64-unknown-linux-gnu ;; esac; \
    curl -fsSL -o /tmp/rustup-init "https://static.rust-lang.org/rustup/archive/$RUSTUP_VERSION/$t/rustup-init"; \
    curl -fsSL "https://static.rust-lang.org/rustup/archive/$RUSTUP_VERSION/$t/rustup-init.sha256" | sed 's# .*#  /tmp/rustup-init#' | sha256sum --check; \
    chmod +x /tmp/rustup-init; /tmp/rustup-init -y --no-modify-path --profile minimal --default-toolchain none; rm /tmp/rustup-init
COPY --from=repo rust-toolchain.toml /src/rust-toolchain.toml
COPY --from=repo tools/slint-fork /src/tools/slint-fork
COPY --from=repo third_party/slint /src/third_party/slint
COPY --from=repo components/c4-toolkit /src/components/c4-toolkit
COPY --from=repo components/c3-shell /src/components/c3-shell
WORKDIR /src
RUN cargo --version && tools/slint-fork/slint-fork.sh setup
WORKDIR /src/components/c3-shell
# ponytail: thin LTO as for atos-comp. Slint's checkout, toolchain and target/ go in the same step (runner disk).
RUN CARGO_PROFILE_RELEASE_LTO=thin CARGO_TERM_COLOR=never cargo build --release --config ../../third_party/slint/patch.toml \
    && strip -o /atos-shell target/release/atos-shell \
    && rm -rf target /src/third_party/slint/src /opt/cargo /opt/rustup

# bootc with our boot-counting patch (#56, D-008; docs/components/c1-base/boot-counting.md), built
# from the upstream tag fedora-bootc 45 ships. Only the binary is copied into `base`.
FROM ${BASE} AS bootc
RUN dnf -y install --setopt=install_weak_deps=False cargo git-core clang-devel ostree-devel \
      openssl-devel libzstd-devel
ENV CARGO_HOME=/opt/cargo
COPY --from=repo third_party/bootc /src
RUN set -eux; . /src/UPSTREAM; \
    git clone -q --depth 1 --branch "$tag" "$repo" /src/bootc; \
    test "$(git -C /src/bootc rev-parse HEAD)" = "$commit"; \
    cd /src/bootc && git apply /src/patches/*.patch \
    && cargo build --release --locked --bin bootc \
    && cargo test --release --locked -p bootc-lib -- boot_count version_floor allowed_transports \
    && strip -o /bootc target/release/bootc && rm -rf target /opt/cargo

# NVIDIA's open kernel modules (D-017, #162; docs/components/c1-base/nvidia.md), not shipped. Built
# from the source tag that matches the userspace (nvidia/UPSTREAM), against exactly the base image's
# kernel, and signed with the TEST db key. D-014: the release key signs only in the owner's local
# release build, never in CI. Only the four signed .ko files are copied into `base`.
# kernel-devel for an older kernel still resolves through Fedora's updates-archive repository.
FROM ${BASE} AS nvidia
COPY nvidia/UPSTREAM /src/UPSTREAM
COPY secureboot-test/db.key secureboot-test/db.crt /keys/
RUN set -eux; . /src/UPSTREAM; kver=$(ls /usr/lib/modules); \
    test "$(rpm -q --qf '%{VERSION}-%{RELEASE}.%{ARCH}' kernel-core)" = "$kver"; \
    dnf -y install --setopt=install_weak_deps=False "kernel-devel-$kver" gcc gcc-c++ make git-core; \
    git clone -q --depth 1 --branch "$tag" "$repo" /src/nv; \
    test "$(git -C /src/nv rev-parse HEAD)" = "$commit"; \
    grep -qx "NVIDIA_VERSION = $tag" /src/nv/version.mk; \
    make -C /src/nv -j"$(nproc)" modules SYSSRC="/usr/src/kernels/$kver"; \
    mkdir /out; for m in nvidia nvidia-modeset nvidia-drm nvidia-uvm; do \
      strip --strip-debug -o "/out/$m.ko" "/src/nv/kernel-open/$m.ko"; \
      "/usr/src/kernels/$kver/scripts/sign-file" sha512 /keys/db.key /keys/db.crt "/out/$m.ko"; \
      test "$(modinfo -F vermagic "/out/$m.ko" | cut -d' ' -f1)" = "$kver"; \
    done; \
    test "$(modinfo -F version /out/nvidia.ko)" = "$tag"

FROM ${BASE} AS base

# D-005: no call home. Fedora's anonymous countme counter runs from this timer.
RUN systemctl mask rpm-ostree-countme.timer

# Session: greetd autologins `atos` into atos-comp; the compositor starts Xwayland itself.
# xterm is the X11 test client until a native X11 app is in the suite. Cleanup of /var/cache etc. is in the next step.
RUN dnf -y install --setopt=install_weak_deps=False greetd greetd-selinux \
      xorg-x11-server-Xwayland mesa-dri-drivers mesa-libgbm libinput libseat libdisplay-info \
      libxkbcommon pixman fontconfig dejavu-sans-fonts xterm \
    && rm -rf /var/lib/greetd/.config /run/selinux-policy \
    && systemctl set-default graphical.target \
    && systemctl enable greetd.service

# NVIDIA graphics (D-017, #162; docs/components/c1-base/nvidia.md). NVK (mesa-vulkan-drivers) for
# every GPU nouveau drives. NVIDIA's userspace and GSP firmware come unmodified from RPM Fusion
# nonfree, at exactly the version the modules above were built from. Its packages require
# `nvidia-kmod` (our signed modules, not a package) and `nvidia-settings` (an X11 GTK tool, left
# out), so dnf cannot install them. They are downloaded and signature-checked, dnf installs what they
# need from Fedora, rpm installs them with --nodeps, and the build fails unless exactly those two
# requirements stay open. On aarch64 (dev VM only; CI and releases are amd64) a third: RPM Fusion
# ships no libnvidia-rmapi-tegra. grubby is left out too: a scriptlet would use it to add
# rd.driver.blacklist=nouveau to GRUB entries, which a UKI does not have and a single image must not get.
# Driver selection and initramfs: usr/lib/modprobe.d/atos-nvidia.conf, usr/lib/dracut/dracut.conf.d/40-atos-nvidia.conf.
# nvidia-powerd (laptop Dynamic Boost), which the package's scriptlet enables, is turned off here and
# at first boot (usr/lib/systemd/system-preset/60-atos-nvidia.preset). Native architecture only: on
# x86_64 RPM Fusion also has i686 builds, which 32-bit apps would need; Flatpak brings its own (D-003).
# Pins, key and modules are bind-mounted, so no layer carries a second copy of them.
RUN --mount=type=bind,source=nvidia,target=/run/nvidia \
    --mount=type=bind,from=nvidia,source=/out,target=/run/nvidia-ko \
    set -eux; . /run/nvidia/UPSTREAM; kver=$(ls /usr/lib/modules); k=/run/nvidia/RPM-GPG-KEY-rpmfusion-nonfree-fedora-2020; \
    open="nvidia-kmod nvidia-settings"; [ "$(uname -m)" != aarch64 ] || open="$open libnvidia-rmapi-tegra.so.$tag"; \
    pkgs="xorg-x11-drv-nvidia xorg-x11-drv-nvidia-libs xorg-x11-drv-nvidia-cuda xorg-x11-drv-nvidia-cuda-libs \
      xorg-x11-drv-nvidia-power nvidia-modprobe nvidia-persistenced"; \
    dnf download --repofrompath="rpmfusion-nonfree,$rpmfusion/$(uname -m)/os/" --repo=rpmfusion-nonfree \
      --arch="$(uname -m)" --destdir /tmp/nvidia/rpm $(for p in $pkgs; do echo "$p-$userspace"; done); \
    rpmkeys --import "$k"; rpmkeys --checksig /tmp/nvidia/rpm/*.rpm; \
    rpm -qp --provides /tmp/nvidia/rpm/*.rpm | sed 's/ .*//' > /tmp/nvidia/own; \
    dnf -y install --setopt=install_weak_deps=False mesa-vulkan-drivers $(rpm -qp --requires /tmp/nvidia/rpm/*.rpm \
      | grep -v -e '^rpmlib(' -e '^(' | sed 's/ .*//' | sort -u | grep -vxF -f /tmp/nvidia/own \
      | grep -vE "^($(echo /usr/bin/grubby $open | tr ' ' '|'))(\(|\$)"); \
    rpm -i --nodeps /tmp/nvidia/rpm/*.rpm; \
    test "$(rpm -V --nofiles $pkgs | sed -n 's/^\t\(.*\) is needed by .*/\1/p' \
      | sed 's/[ (].*//' | LC_ALL=C sort -u | xargs)" = "$(printf '%s\n' $open | LC_ALL=C sort | xargs)"; \
    test "$(rpm -q --qf '%{VERSION}' xorg-x11-drv-nvidia)" = "$tag"; \
    test -z "$(rpm -qa --qf '%{ARCH}\n' | grep -vxE "$(uname -m)|noarch|\(none\)")"; \
    install -D -m 0644 -t "/usr/lib/modules/$kver/extra/nvidia" /run/nvidia-ko/*.ko; depmod -a "$kver"; \
    systemctl enable nvidia-suspend.service nvidia-resume.service nvidia-hibernate.service \
      nvidia-suspend-then-hibernate.service; \
    systemctl disable nvidia-powerd.service; \
    rm -rf /tmp/nvidia /run/dnf /var/lib/dnf /var/cache/* /var/log/*

# systemd-boot instead of bootupd/GRUB/shim: sealed images boot systemd-boot signed with our own
# key (D-014), and bootc picks systemd-boot when bootupd is absent.
RUN dnf -y install systemd-boot-unsigned \
    && rpm -e --nodeps bootupd \
    && rpm -e $(rpm -qa 'shim-*' 'grub2-efi-*') \
    && rm -rf /usr/lib/bootupd /run/dnf /var/lib/dnf /var/cache/* /var/log/*

# Install config (filesystem with fs-verity, kernel arguments) and the
# TEST Secure Boot keys. systemd-boot enrols the set named `auto` by itself, but only in a VM in
# setup mode (`secure-boot-enroll if-safe`, loader.conf(5)).
COPY usr/ /usr/
COPY secureboot-test/PK.auth secureboot-test/KEK.auth secureboot-test/db.auth /usr/lib/bootc/install/secureboot-keys/auto/

# Trust policy (#75, docs/components/c1-base/trust-policy.md): pulls of the Atos image need a
# signature by this TEST cosign key (policy.json and registries.d come with usr/ above).
COPY cosign.pub /usr/share/pki/containers/atos-c1-base-test.pub

# Apps: Flatpak with Flathub as the only, system-wide default remote (D-003, #187; docs/components/c1-base/README.md,
# "Apps: Flatpak and Flathub"). flathub.flatpakrepo is Flathub's own file with its signing key (the same key as in
# Fedora's signed fedora-flathub-remote); flatpak reads it from remotes.d. Fedora's service that adds its own OCI
# remotes is masked. atos-flatpak-no-os-info turns off the Flatpak-Os-Info header once (D-005). No portals here.
RUN dnf -y install --setopt=install_weak_deps=False flatpak \
    && systemctl mask flatpak-add-fedora-repos.service \
    && systemctl enable atos-flatpak-no-os-info.service \
    && rm -rf /run/selinux-policy /run/dnf /var/lib/dnf /var/cache/* /var/log/*
COPY flatpak/flathub.flatpakrepo /usr/share/flatpak/remotes.d/flathub.flatpakrepo

# Wi-Fi and Bluetooth (#231; docs/components/c1-base/README.md, "Wi-Fi and Bluetooth"). NetworkManager drives Wi-Fi
# through iwd (owner decision on #231), so wpa_supplicant stays out; usr/lib/NetworkManager/conf.d/90-atos.conf sets the
# backend and turns the connectivity check off (D-005). iwd keeps its default EnableNetworkConfiguration=false, so
# NetworkManager alone owns addresses and DNS. bluez keeps its defaults: not discoverable, no pairing without an agent.
# iwlwifi-mvm-firmware pulls in the mld (Wi-Fi 7) and Intel Bluetooth firmware; dvm is for older Intel cards, brcmfmac
# for Broadcom. Realtek, MediaTek and Atheros/Qualcomm firmware is already in the base. /var dirs: atos-wireless.conf.
RUN dnf -y install --setopt=install_weak_deps=False NetworkManager-wifi iwd bluez wireless-regdb \
      iwlwifi-mvm-firmware iwlwifi-dvm-firmware brcmfmac-firmware \
    && ! rpm -q wpa_supplicant \
    && systemctl enable iwd.service bluetooth.service \
    && rm -rf /run/dnf /var/lib/dnf /var/cache/* /var/log/*

COPY session/ /
# Boot counting (#56): patched bootc names an upgrade's UKI entry `…+3.conf`; the health check
# decides when a counted boot is good (usr/lib/systemd/system/atos-session-check.service). The
# initramfs is rebuilt in the `kernel` stage below.
COPY --from=bootc /bootc /usr/bin/bootc
RUN systemctl enable atos-session-check.service \
    && semodule -i /usr/share/atos/selinux/atos-bless-boot.cil \
    && rm -rf /var/tmp/*
COPY --from=comp /atos-comp /usr/bin/atos-comp
# The shell (C3, #186): dock, launcher, control centre. Started by the session wrapper
# (usr/libexec/atos/atos-session, docs/components/c1-base/README.md "Session"); atos-comp's launcher
# shortcut runs `atos-shell --launcher`. Runtime libraries (EGL, PipeWire client) and the portal
# registration for dark mode (data/atos.portal) come with it.
COPY --from=shell /atos-shell /usr/bin/atos-shell
COPY --from=repo components/c3-shell/data/atos.portal /usr/share/xdg-desktop-portal/portals/atos.portal
RUN dnf -y install --setopt=install_weak_deps=False mesa-libEGL pipewire-libs \
    && ldd /usr/bin/atos-shell | grep -v 'not found' >/dev/null && ! ldd /usr/bin/atos-shell | grep 'not found' \
    && rm -rf /run/dnf /var/lib/dnf /var/cache/* /var/log/*
COPY --from=repo components/c2-compositor/data/keybindings.ron /usr/share/cosmic/com.system76.CosmicSettings.Shortcuts/v1/defaults
COPY --from=repo components/c2-compositor/data/tiling-exceptions.ron /usr/share/cosmic/com.system76.CosmicSettings.WindowRules/v1/tiling_exception_defaults

LABEL org.opencontainers.image.title="Atos base"

# Tools for signing; never part of the final image.
FROM base AS tools
RUN dnf -y install systemd-ukify sbsigntools
COPY secureboot-test/db.key secureboot-test/db.crt /keys/

# systemd-boot signed with the TEST db key. bootctl installs `<name>.efi.signed` when it exists.
FROM tools AS sdboot
RUN for f in /usr/lib/systemd/boot/efi/systemd-boot*.efi; do \
      sbsign --key /keys/db.key --cert /keys/db.crt --output "$f.signed" "$f"; done

# Kernel and initramfs for the UKI (not shipped): only the `uki` stage reads /kernel. The
# initramfs is rebuilt here with Fedora's dracut config plus ours, so a counted boot that fails in
# the initrd reboots too (#56, usr/lib/dracut/dracut.conf.d/40-atos-boot-counting.conf); built in
# `base`, it would ship in a layer of the image (#111).
FROM base AS kernel
RUN kver=$(ls /usr/lib/modules) && dracut --force --kver "$kver" "/usr/lib/modules/$kver/initramfs.img" \
    && lsinitrd "/usr/lib/modules/$kver/initramfs.img" | grep -q 'emergency.service.d/10-atos-boot-counting.conf' \
    && ! lsinitrd "/usr/lib/modules/$kver/initramfs.img" | grep -E '/(nvidia|nouveau)[^/]*\.ko' \
    && bootc container split-kernel-and-rootfs --output /kernel

# The rootfs the UKI seals: kernel and initramfs move out of /usr, into the UKI. The split runs
# again here and its output is deleted in the same layer, so no layer of the image carries it (#111).
FROM base AS rootfs
COPY --from=sdboot /usr/lib/systemd/boot/efi/ /usr/lib/systemd/boot/efi/
# Directory mtimes: the digest of this rootfs (computed from the filesystem at build time) must equal
# the one bootc install computes from the OCI layers. Directories our layers changed come out
# differently in the two (composefs-rs design notes, containers/composefs-rs#132), so this layer
# sets every directory to the epoch, as the base image already has it.
RUN bootc container split-kernel-and-rootfs --output /kernel && rm -rf /kernel \
    && find / -xdev -type d -newermt @0 ! -path /proc ! -path /sys ! -path /dev -exec touch -h -d @0 {} + \
    && bootc container lint --fatal-warnings

# Composefs digest of `rootfs` into the kernel command line, UKI signed with the TEST db key.
FROM tools AS uki
RUN --mount=type=bind,from=rootfs,target=/target \
    --mount=type=bind,from=kernel,source=/kernel,target=/kernel \
    kver=$(ls /kernel) && mkdir /out && \
    bootc container ukify --rootfs /target --kernel-dir "/kernel/$kver" -- \
      --output "/out/$kver.efi" --signtool sbsign \
      --secureboot-private-key /keys/db.key --secureboot-certificate /keys/db.crt

# /boot is outside the composefs digest; Secure Boot checks the UKI instead.
FROM rootfs
COPY --from=uki /out/ /boot/EFI/Linux/

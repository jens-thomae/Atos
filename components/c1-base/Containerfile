# Atos base image (C1): a sealed composefs image with a signed UKI and systemd-boot (D-008).
# Docs: docs/components/c1-base/README.md. Recipe: bootc-sealed-images(7).
# Build: podman build --build-context repo=. -f components/c1-base/Containerfile components/c1-base
# (`repo` is the repository root: the compositor source and the toolchain pin come from there.)
# Base: fedora-bootc 45 (D-008), multi-arch index digest; version 45.20261107.0.
ARG BASE=quay.io/fedora/fedora-bootc:45@sha256:451894faadba48a53c4449efa8b872a1c004b80d8bb3dab71c4c93f631129d59

# atos-comp (C2) is built in its own stage and only the stripped binary is copied into `base`.
# Same base image, so its layers are already pulled.
FROM ${BASE} AS comp
RUN dnf -y install --setopt=install_weak_deps=False gcc clang pkgconf-pkg-config git curl \
      systemd-devel mesa-libgbm-devel mesa-libEGL-devel libxkbcommon-devel wayland-devel \
      libinput-devel dbus-devel libseat-devel libdisplay-info-devel pixman-devel fontconfig-devel
ARG RUSTUP_VERSION=1.29.3
# /root is a symlink into /var in bootc images, so keep the toolchain elsewhere.
ENV CARGO_HOME=/opt/cargo RUSTUP_HOME=/opt/rustup PATH=/opt/cargo/bin:$PATH
# rustup-init pinned by version; the checksum comes from the same host (integrity, not authenticity).
RUN set -eux; \
    case "$(uname -m)" in x86_64) t=x86_64-unknown-linux-gnu ;; aarch64) t=aarch64-unknown-linux-gnu ;; esac; \
    curl -fsSL -o /tmp/rustup-init "https://static.rust-lang.org/rustup/archive/$RUSTUP_VERSION/$t/rustup-init"; \
    curl -fsSL "https://static.rust-lang.org/rustup/archive/$RUSTUP_VERSION/$t/rustup-init.sha256" | sed 's# .*#  /tmp/rustup-init#' | sha256sum --check; \
    chmod +x /tmp/rustup-init; /tmp/rustup-init -y --no-modify-path --profile minimal --default-toolchain none; rm /tmp/rustup-init
COPY --from=repo rust-toolchain.toml /src/rust-toolchain.toml
COPY --from=repo components/c2-compositor /src/components/c2-compositor
WORKDIR /src/components/c2-compositor
# ponytail: thin LTO (upstream uses fat) to keep the hosted build short; revisit with the budgets.
# Toolchain and target/ are removed in the same step: they do not fit the runner disk as a layer.
RUN cp ../../rust-toolchain.toml . \
    && CARGO_PROFILE_RELEASE_LTO=thin CARGO_TERM_COLOR=never cargo build --release --locked \
    && strip -o /atos-comp target/release/atos-comp \
    && rm -rf target /opt/cargo /opt/rustup

# bootc with our boot-counting patch (#56, D-008; docs/components/c1-base/boot-counting.md), built
# from the upstream tag fedora-bootc 45 ships. Only the binary is copied into `base`.
FROM ${BASE} AS bootc
RUN dnf -y install --setopt=install_weak_deps=False cargo git-core clang-devel ostree-devel \
      openssl-devel libzstd-devel
ENV CARGO_HOME=/opt/cargo
COPY --from=repo third_party/bootc /src
RUN set -eux; . /src/UPSTREAM; \
    git clone -q --depth 1 --branch "$tag" "$repo" /src/bootc; \
    test "$(git -C /src/bootc rev-parse HEAD)" = "$commit"; \
    cd /src/bootc && git apply /src/patches/*.patch \
    && cargo build --release --locked --bin bootc \
    && cargo test --release --locked -p bootc-lib boot_count \
    && strip -o /bootc target/release/bootc && rm -rf target /opt/cargo

FROM ${BASE} AS base

# D-005: no call home. Fedora's anonymous countme counter runs from this timer.
RUN systemctl mask rpm-ostree-countme.timer

# Session: greetd autologins `atos` into atos-comp; the compositor starts Xwayland itself.
# xterm is the X11 test client until a native X11 app is in the suite. Cleanup of /var/cache etc. is in the next step.
RUN dnf -y install --setopt=install_weak_deps=False greetd greetd-selinux \
      xorg-x11-server-Xwayland mesa-dri-drivers mesa-libgbm libinput libseat libdisplay-info \
      libxkbcommon pixman fontconfig dejavu-sans-fonts xterm \
    && rm -rf /var/lib/greetd/.config /run/selinux-policy \
    && systemctl set-default graphical.target \
    && systemctl enable greetd.service

# systemd-boot instead of bootupd/GRUB/shim: sealed images boot systemd-boot signed with our own
# key (D-014), and bootc picks systemd-boot when bootupd is absent.
RUN dnf -y install systemd-boot-unsigned \
    && rpm -e --nodeps bootupd \
    && rpm -e $(rpm -qa 'shim-*' 'grub2-efi-*') \
    && rm -rf /usr/lib/bootupd /run/dnf /var/lib/dnf /var/cache/* /var/log/*

# Install config (filesystem with fs-verity, kernel arguments) and the
# TEST Secure Boot keys. systemd-boot enrols the set named `auto` by itself, but only in a VM in
# setup mode (`secure-boot-enroll if-safe`, loader.conf(5)).
COPY usr/ /usr/
COPY secureboot-test/PK.auth secureboot-test/KEK.auth secureboot-test/db.auth /usr/lib/bootc/install/secureboot-keys/auto/

COPY session/ /
# Boot counting (#56): patched bootc names an upgrade's UKI entry `…+3.conf`; the health check
# decides when a counted boot is good (usr/lib/systemd/system/atos-session-check.service). The
# initramfs is rebuilt in the `kernel` stage below.
COPY --from=bootc /bootc /usr/bin/bootc
RUN systemctl enable atos-session-check.service \
    && semodule -i /usr/share/atos/selinux/atos-bless-boot.cil \
    && rm -rf /var/tmp/*
COPY --from=comp /atos-comp /usr/bin/atos-comp
COPY --from=repo components/c2-compositor/data/keybindings.ron /usr/share/cosmic/com.system76.CosmicSettings.Shortcuts/v1/defaults
COPY --from=repo components/c2-compositor/data/tiling-exceptions.ron /usr/share/cosmic/com.system76.CosmicSettings.WindowRules/v1/tiling_exception_defaults

LABEL org.opencontainers.image.title="Atos base"

# Tools for signing; never part of the final image.
FROM base AS tools
RUN dnf -y install systemd-ukify sbsigntools
COPY secureboot-test/db.key secureboot-test/db.crt /keys/

# systemd-boot signed with the TEST db key. bootctl installs `<name>.efi.signed` when it exists.
FROM tools AS sdboot
RUN for f in /usr/lib/systemd/boot/efi/systemd-boot*.efi; do \
      sbsign --key /keys/db.key --cert /keys/db.crt --output "$f.signed" "$f"; done

# Kernel and initramfs for the UKI (not shipped): only the `uki` stage reads /kernel. The
# initramfs is rebuilt here with Fedora's dracut config plus ours, so a counted boot that fails in
# the initrd reboots too (#56, usr/lib/dracut/dracut.conf.d/40-atos-boot-counting.conf); built in
# `base`, it would ship in a layer of the image (#111).
FROM base AS kernel
RUN kver=$(ls /usr/lib/modules) && dracut --force --kver "$kver" "/usr/lib/modules/$kver/initramfs.img" \
    && lsinitrd "/usr/lib/modules/$kver/initramfs.img" | grep -q 'emergency.service.d/10-atos-boot-counting.conf' \
    && bootc container split-kernel-and-rootfs --output /kernel

# The rootfs the UKI seals: kernel and initramfs move out of /usr, into the UKI. The split runs
# again here and its output is deleted in the same layer, so no layer of the image carries it (#111).
FROM base AS rootfs
COPY --from=sdboot /usr/lib/systemd/boot/efi/ /usr/lib/systemd/boot/efi/
# Directory mtimes: the digest of this rootfs (computed from the filesystem at build time) must equal
# the one bootc install computes from the OCI layers. Directories our layers changed come out
# differently in the two (composefs-rs design notes, containers/composefs-rs#132), so this layer
# sets every directory to the epoch, as the base image already has it.
RUN bootc container split-kernel-and-rootfs --output /kernel && rm -rf /kernel \
    && find / -xdev -type d -newermt @0 ! -path /proc ! -path /sys ! -path /dev -exec touch -h -d @0 {} + \
    && bootc container lint --fatal-warnings

# Composefs digest of `rootfs` into the kernel command line, UKI signed with the TEST db key.
FROM tools AS uki
RUN --mount=type=bind,from=rootfs,target=/target \
    --mount=type=bind,from=kernel,source=/kernel,target=/kernel \
    kver=$(ls /kernel) && mkdir /out && \
    bootc container ukify --rootfs /target --kernel-dir "/kernel/$kver" -- \
      --output "/out/$kver.efi" --signtool sbsign \
      --secureboot-private-key /keys/db.key --secureboot-certificate /keys/db.crt

# /boot is outside the composefs digest; Secure Boot checks the UKI instead.
FROM rootfs
COPY --from=uki /out/ /boot/EFI/Linux/

# Atos installer ISO (C11, #66): a live system that runs atos-install on tty1.
# Docs: docs/components/c11-installer/README.md.
# Build: podman build --build-context repo=. -t atos-installer components/c11-installer
# ISO:   image-builder generic-iso from this image, with the c1-base image as payload (see build-iso.sh).
# Same base as c1-base, so the layers are shared. Keep in step with components/c1-base/Containerfile.
# Mirror and upstream record: docs/components/c1-base/base-mirror.md.
# upstream: quay.io/fedora/fedora-bootc:45@sha256:0c0d822e8545efe843e72f4a216295e9fd3d8a8213709fff0db6844b5d9aad29
ARG BASE=ghcr.io/jens-thomae/atos/fedora-bootc:45.20261108.0@sha256:0c0d822e8545efe843e72f4a216295e9fd3d8a8213709fff0db6844b5d9aad29

FROM ${BASE} AS build
RUN dnf -y install --setopt=install_weak_deps=False gcc curl
ARG RUSTUP_VERSION=1.29.3
ENV CARGO_HOME=/opt/cargo RUSTUP_HOME=/opt/rustup PATH=/opt/cargo/bin:$PATH
# rustup-init pinned by version, as in c1-base's comp stage.
RUN set -eux; \
    case "$(uname -m)" in x86_64) t=x86_64-unknown-linux-gnu ;; aarch64) t=aarch64-unknown-linux-gnu ;; esac; \
    curl -fsSL -o /tmp/rustup-init "https://static.rust-lang.org/rustup/archive/$RUSTUP_VERSION/$t/rustup-init"; \
    curl -fsSL "https://static.rust-lang.org/rustup/archive/$RUSTUP_VERSION/$t/rustup-init.sha256" | sed 's# .*#  /tmp/rustup-init#' | sha256sum --check; \
    chmod +x /tmp/rustup-init; /tmp/rustup-init -y --no-modify-path --profile minimal --default-toolchain none; rm /tmp/rustup-init
WORKDIR /src
# The workspace manifest names every member, so cargo needs them all present.
COPY --from=repo Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY --from=repo tools/budgets tools/budgets
COPY --from=repo tools/tokens tools/tokens
COPY --from=repo components/c11-installer components/c11-installer
RUN CARGO_TERM_COLOR=never cargo build --release --locked -p atos-install \
    && strip -o /atos-install target/release/atos-install

FROM ${BASE}
# ISO build tools (image-builder runs them from this image) and the live-boot dracut module.
# The ISO boots through Fedora's Microsoft-signed shim and GRUB, so it starts with Secure Boot on
# stock firmware (owner answer on #66). Only the media does; installed systems boot systemd-boot
# and the sealed UKI from c1-base.
RUN dnf -y install --setopt=install_weak_deps=False \
      grub2-efi-*-cdboot dracut-live implantisomd5 xorrisofs squashfs-tools \
    && dnf clean all \
    && mkdir -p /boot/efi && cp -ra /usr/lib/efi/*/*/EFI /boot/efi
# Identity (#248): the live system calls itself Atos too, with c1-base's files (see c1-base's Containerfile).
RUN dnf -y install --allowerasing generic-release && dnf clean all
COPY --from=repo components/c1-base/usr/lib/os-release components/c1-base/usr/lib/fedora-release /usr/lib/
COPY dracut-40-iso.conf /usr/lib/dracut/dracut.conf.d/40-iso.conf
RUN set -xe; kver=$(ls /usr/lib/modules); env DRACUT_NO_XATTR=1 dracut -f /usr/lib/modules/$kver/initramfs.img "$kver"
COPY iso.yaml /usr/lib/image-builder/bootc/iso.yaml
COPY atos-installer.service /usr/lib/systemd/system/atos-installer.service
COPY --from=build /atos-install /usr/bin/atos-install
COPY install-policy.json /usr/share/atos-install/install-policy.json
# The live system runs only the installer: no bootloader updates, no greeter, no update timers.
# Nothing else on tty1 (#220): on Fedora 45 its console is kmscon (kmsconvt@tty1, started with
# getty.target, and autovt@tty1, which logind starts while tty1 is free). kmscon takes over the
# display and the keyboard, so the installer ran where nobody could see or answer it.
RUN systemctl mask bootloader-update.service bootc-fetch-apply-updates.timer rpm-ostree-countme.timer \
      kmsconvt@tty1.service autovt@tty1.service \
    && systemctl disable getty@tty1.service \
    && systemctl enable atos-installer.service
LABEL org.opencontainers.image.title="Atos installer"

[Unit]
Description=Atos installer
After=systemd-user-sessions.service plymouth-quit-wait.service
Conflicts=getty@tty1.service

[Service]
Type=idle
ExecStart=/usr/bin/atos-install
ExecStartPost=-/usr/bin/systemctl reboot
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target

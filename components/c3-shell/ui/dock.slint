// The dock-taskbar (spec §11): a floating bar at the bottom of each output with one slot per
// running window. Values come only from the design tokens (docs/design/tokens.json); the layout
// follows the owner's Dock mockup on the design canvas (docs/design/README.md).
import { Fonts, Palette, Radius, Size, Space, Type } from "../../c4-toolkit/ui/tokens.slint";

export struct DockItem {
    id: int,
    title: string,
    // Empty when no icon was found; the tile then shows `initial`.
    icon: image,
    initial: string,
    focused: bool,
}

component Slot inherits Rectangle {
    in property <DockItem> item;
    callback activate();

    width: Size.dock-slot-w;
    height: Size.dock-slot-h;
    accessible-role: button;
    accessible-label: root.item.focused ? root.item.title + ", focused" : root.item.title + ", running";
    accessible-action-default => { root.activate(); }
    forward-focus: focus;

    focus := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Return || e.text == Key.Space {
                root.activate();
                return accept;
            }
            reject
        }
    }

    touch := TouchArea {
        clicked => { root.activate(); }
    }

    tile := Rectangle {
        x: (parent.width - self.width) / 2;
        y: Space.s1;
        width: Size.dock-tile;
        height: Size.dock-tile;
        border-radius: Radius.tile;
        clip: true;
        background: root.item.icon.width > 0 ? transparent : Palette.button-secondary;

        Image {
            width: parent.width;
            height: parent.height;
            source: root.item.icon;
        }

        if root.item.icon.width == 0: Text {
            text: root.item.initial;
            color: Palette.text;
            font-size: Type.headline.size;
            font-weight: Type.headline.weight;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        // Hover and press feedback on every tile, icon or not.
        Rectangle {
            background: touch.pressed ? Palette.pressed : touch.has-hover ? Palette.hover : transparent;
        }
    }

    // Focus ring, keyboard focus only.
    if focus.has-focus: Rectangle {
        x: tile.x - Size.focus-ring-offset - Size.focus-ring-width;
        y: tile.y - Size.focus-ring-offset - Size.focus-ring-width;
        width: tile.width + 2 * (Size.focus-ring-offset + Size.focus-ring-width);
        height: tile.height + 2 * (Size.focus-ring-offset + Size.focus-ring-width);
        border-radius: Radius.tile + Size.focus-ring-offset + Size.focus-ring-width;
        border-width: Size.focus-ring-width;
        border-color: Palette.accent;
    }

    // Running indicator: a dot, wider and in the accent colour for the focused window.
    Rectangle {
        width: root.item.focused ? Space.s4 : Space.s1;
        height: Space.s1;
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height;
        border-radius: self.height / 2;
        background: root.item.focused ? Palette.accent : Palette.text-3;
    }
}

export component Dock inherits Window {
    in property <[DockItem]> items;
    callback activate(int);
    // Gap between the dock and the screen edges; the shell sets it as the layer surface's margin.
    out property <length> edge-gap: Space.s3;

    title: "Dock";
    background: transparent;
    default-font-family: Fonts.sans;
    preferred-height: Size.dock-height;

    Rectangle {
        background: Palette.panel;
        border-radius: Radius.overlay;
        border-width: Size.hairline;
        border-color: Palette.panel-line;

        HorizontalLayout {
            alignment: center;
            padding-left: Space.s3;
            padding-right: Space.s3;
            spacing: Space.s2;

            for item in root.items: VerticalLayout {
                alignment: center;
                Slot {
                    item: item;
                    activate => { root.activate(item.id); }
                }
            }
        }
    }
}

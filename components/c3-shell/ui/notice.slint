// The shell's one notification (#138): the disk is not sealed to the TPM. A card in the top right
// corner of the output. Values come only from the design tokens (docs/design/tokens.json).
import { Fonts, Palette, Size, Space, Type } from "../../c4-toolkit/ui/tokens.slint";
import { Button, Panel } from "../../c4-toolkit/ui/widgets.slint";

export component Notice inherits Window {
    in property <string> heading;
    in property <string> body;
    in property <string> learn-more: "Learn more";
    in property <string> dismiss: "Dismiss";
    // Fonts.sans; tests set the bundled font (docs/components/c4-toolkit/screenshot-tests.md).
    in property <string> font-family: Fonts.sans;
    callback open-docs();
    callback dismissed();
    // Gap to the screen edges; the shell sets it as the layer surface's margin.
    out property <length> edge-gap: Space.s3;

    title: "Notification";
    background: transparent;
    default-font-family: root.font-family;
    preferred-width: Space.s7 * 8;
    preferred-height: col.preferred-height + Space.s4 * 2;

    Panel {
        background: Palette.overlay-card;
        border-color: Palette.overlay-card-line;
    }
    col := VerticalLayout {
        padding: Space.s4;
        spacing: Space.s2;
        Text {
            text: root.heading;
            font-size: Type.headline.size;
            font-weight: Type.headline.weight;
            color: Palette.warning;
            wrap: word-wrap;
        }
        Text {
            text: root.body;
            font-size: Type.body.size;
            color: Palette.text-2;
            wrap: word-wrap;
        }
        HorizontalLayout {
            padding-top: Space.s2;
            spacing: Space.s2;
            alignment: end;
            Button {
                label: root.dismiss;
                width: Space.s7 * 2;
                clicked => { root.dismissed(); }
            }
            Button {
                label: root.learn-more;
                primary: true;
                width: Space.s7 * 2;
                clicked => { root.open-docs(); }
            }
        }
    }
}
